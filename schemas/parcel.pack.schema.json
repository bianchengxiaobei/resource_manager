{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parcel Pack Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "version", "cooked", "output"],
  "properties": {
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "cooked": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "compression": {"enum": ["none", "lz4", "zstd"]},
    "blockSize": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "compressionLevel": {"type": "integer", "minimum": 0, "maximum": 22},
    "jobs": {"type": "integer", "minimum": 1},
    "enableAddressable": {"type": "boolean"},
    "supportExtensionless": {"type": "boolean"},
    "locationToLower": {"type": "boolean"},
    "includeAssetGuid": {"type": "boolean"},
    "replaceAssetPathWithAddress": {"type": "boolean"},
    "useSourcePath": {"type": "boolean"},
    "forceSubAssetGrouping": {"type": "boolean"},
    "autoCollectShaders": {"type": "boolean"},
    "writeBuiltinCatalog": {"type": "boolean"},
    "enableShareBundle": {"type": "boolean"},
    "singleReferencedPackAlone": {"type": "boolean"},
    "clean": {"type": "boolean"},
    "verifyOutput": {"type": "boolean"},
    "outputNameStyle": {"enum": [0, 1, 2, 3]},
    "buildBundleType": {"enum": [0, 1, 2, 3]},
    "collectors": {
      "type": "array",
      "items": {"$ref": "#/$defs/collector"}
    }
  },
  "$defs": {
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "type": {"enum": ["main", "static", "depend"]},
        "path": {"type": "string"},
        "files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "include": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "recursive": {"type": "boolean"},
        "addressRule": {"enum": ["assetPath", "fileName", "guid", "prefix", "address"]},
        "addressPrefix": {"type": "string"},
        "address": {"type": "string"},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "bundle": {"type": "string"},
        "group": {"type": "string"},
        "packRule": {
          "enum": [
            "Default",
            "PackSeparately",
            "PackDirectory",
            "PackTopDirectory",
            "PackCollector",
            "PackGroup",
            "PackRawFile",
            "PackVideoFile",
            "PackShader",
            "PackShaderVariants"
          ]
        },
        "filterRule": {
          "enum": [
            "CollectAll",
            "CollectScene",
            "CollectShader",
            "CollectRaw",
            "CollectVideo",
            "CollectTexture",
            "CollectMaterial",
            "CollectMesh",
            "CollectAnimation",
            "CollectText",
            "CollectIES",
            "CollectPrefab",
            "CollectSprite",
            "CollectShaderVariants"
          ]
        },
        "share": {"type": "boolean"},
        "archive": {"type": "boolean"}
      }
    }
  }
}
